{
  "name": "gartenplaner",
  "version": "1.0.0",
  "description": "Gartenplaner - Garden task management with REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:server": "jest tests/server",
    "test:frontend": "jest tests/frontend",
    "test:smoke": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format:check": "node scripts/format-check.cjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "axe-core": "4.11.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jest": "^30.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
