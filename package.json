{
  "name": "gartenplaner",
  "version": "3.11.2",
  "description": "Gartenplaner - Webanwendung mit REST API zur Verwaltung von Gartenaufgaben",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "migrate": "node scripts/migrate.js",
    "migrate-photos": "node scripts/migrate-photos.js",
    "seed-admin": "node scripts/seed-admin.js",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "picomatch": "^4.0.4",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tar": ">=7.5.13",
    "brace-expansion": ">=2.0.3",
    "minimatch": ">=9.0.7",
    "glob": ">=10.5.0",
    "picomatch": "$picomatch"
  }
}
