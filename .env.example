# API Key for external access (e.g. n8n). Required when NODE_ENV=production
# (the Docker image default): the server refuses to start without it.
API_KEY=your-secret-api-key-here

# Deliberately run production without authentication (only behind a trusted
# gateway/network). Without API_KEY and without this opt-out, production aborts.
# ALLOW_UNAUTHENTICATED=true

# Server port (default: 3000)
PORT=3000

# Optional isolated storage/log paths (defaults retained when unset)
# DATA_DIR=/absolute/path/to/data
# LOG_DIR=/absolute/path/to/logs
