            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "tags": ["Backup"],
        "summary": "Gesamten Datenbestand exportieren",
        "description": "Liefert Aufgaben, Archiv und eine eigene Pflanzenliste als ein JSON-Bündel (Header `Content-Disposition: attachment`, `Cache-Control: no-store`). Enthält Aufgabendaten, aber nie den API-Key. Der Schnappschuss ist konsistent, auch während archiviert wird.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Export-Bündel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportBundle"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/import": {
      "post": {
        "tags": ["Backup"],
        "summary": "Export-Bündel importieren",
        "description": "Überschreibt nie unbemerkt. Ohne `mode` wird nur in eine leere Instanz importiert (sonst `409`). `mode=merge` ergänzt unbekannte IDs und meldet vorhandene unter `skipped`. `mode=replace` ersetzt alles, braucht `confirm=replace` und legt vorher eine Sicherung unter `backups/` im Datenverzeichnis an. Das Bündel wird vollständig validiert, bevor geschrieben wird; bei jedem Fehler bleibt der Bestand unverändert. Body-Limit für diese Route: 5 MB (alle anderen Routen: 100 kB).",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["merge", "replace"]
            }
          },
          {
            "name": "confirm",
            "in": "query",
            "description": "Muss bei `mode=replace` den Wert `replace` haben.",
            "schema": {
              "type": "string",
              "enum": ["replace"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportBundle"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import-Ergebnis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "400": {
            "description": "Ungültiges Bündel (`errors`, deutsche Meldungen, höchstens 20), ungültiger `mode` oder fehlende Bestätigung (`error`), ungültiges JSON",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/Errors"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Zielinstanz ist nicht leer (nur ohne `mode`) oder die vorhandene `plants.json` ist bei `mode=merge` nicht lesbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "413": {
            "description": "Body größer als 5 MB (`error`) oder mehr als 10000 Aufgaben bzw. 1000 Pflanzen im Bündel (`errors`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/Errors"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Pflicht, wenn der Server mit `API_KEY` läuft (in Produktion der Standard)."
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Ungültige Anfrage",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationErrors": {
        "description": "Validierung fehlgeschlagen (deutsche Meldungen)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        }
      },
      "InvalidId": {
        "description": "`id` ist keine UUID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "`X-API-Key` fehlt oder ist falsch",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Aufgabe nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Body größer als 100 kB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Mehr als 100 Anfragen in 15 Minuten. Antwort ist Text (`text/html`), Header `Retry-After` und `RateLimit-*` sind gesetzt.",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Errors": {
        "type": "object",
        "required": ["errors"],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": ["pending", "in-progress", "completed"]
      },
      "Priority": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "Recurrence": {
        "type": "string",
        "enum": ["none", "daily", "weekly", "monthly"],
        "description": "Wiederholung. Beim Wechsel einer Aufgabe auf `completed` erzeugt der Server die Folgeaufgabe (`daily`: +1 Tag, `weekly`: +7 Tage, `monthly`: +1 Monat, begrenzt auf das Monatsende) mit neuem `dueDate`."
      },
      "SubtaskInput": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "completed": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "Subtask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "edited",
              "completed",
              "reopened",
              "archived",
              "unarchived"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TaskFields": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "employee": {
            "type": "string",
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence": {
            "$ref": "#/components/schemas/Recurrence"
          },
          "dueDate": {
            "$ref": "#/components/schemas/DueDate"
          },
          "plantId": {
            "$ref": "#/components/schemas/PlantId"
          },
          "subtasks": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/SubtaskInput"
            }
          }
        }
      },
      "TaskInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TaskFields"
          },
          {
            "type": "object",
            "required": ["title", "location"]
          }
        ]
      },
      "TaskUpdate": {
        "$ref": "#/components/schemas/TaskFields"
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "location",
          "status",
          "priority",
          "recurrence",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "employee": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence": {
            "$ref": "#/components/schemas/Recurrence"
          },
          "dueDate": {
            "$ref": "#/components/schemas/DueDate"
          },
          "plantId": {
            "$ref": "#/components/schemas/PlantId"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sortOrder": {
            "type": "number"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subtask"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            }
          },
          "followUpId": {
            "type": "string",
            "format": "uuid",
            "description": "Id der beim Abschluss erzeugten Folgeaufgabe (nur bei Wiederholung)."
          },
          "recurrenceOf": {
            "type": "string",
            "format": "uuid",
            "description": "Nur an Folgeaufgaben: Id der abgeschlossenen Aufgabe, aus der sie entstand."
          },
          "lastRecurrence": {
            "type": "string",
            "format": "date-time",
            "description": "Nur an Folgeaufgaben: Abschlusszeitpunkt der Vorgängerin."
          },
          "nextDue": {
            "type": "string",
            "format": "date-time",
            "deprecated": true,
            "description": "Veraltet: Altfeld aus der Zeit vor `dueDate` (Abschlusszeit der Vorgängerin plus Intervall). Wird nicht mehr geschrieben und von keiner Logik ausgewertet, bleibt aber in alten Daten und beim Import erhalten. Maßgeblich ist `dueDate`."
          }
        }
      },
      "TaskUpdateResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Task"
          },
          {
            "type": "object",
            "properties": {
              "followUp": {
                "$ref": "#/components/schemas/Task"
              }
            },
            "description": "`followUp` ist nur vorhanden, wenn dieses PUT eine Folgeaufgabe erzeugt hat."
          }
        ]
      },
      "TaskPage": {
        "type": "object",
        "required": ["data", "total", "page", "limit", "pages"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "TaskSearch": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "employee": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "dueFrom": {
            "type": "string",
            "format": "date",
            "description": "Nur Aufgaben mit `dueDate` ab diesem Tag (inklusive). Aufgaben ohne Termin fallen heraus."
          },
          "dueTo": {
            "type": "string",
            "format": "date",
            "description": "Nur Aufgaben mit `dueDate` bis zu diesem Tag (inklusive)."
          },
          "plantId": {
            "$ref": "#/components/schemas/PlantId"
          },
          "sort": {
            "type": "string",
            "enum": ["dueDate"],
            "description": "Sortierung nach Fälligkeit aufsteigend, Aufgaben ohne Termin zuletzt."
          }
        }
      },
      "Plant": {
        "type": "object",
        "required": ["id", "name", "category"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Slug aus Kleinbuchstaben, Ziffern und Bindestrichen",
            "example": "tomato"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "example": "Kohlrabi"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Gemüse"
          },
          "icon": {
            "type": "string",
            "description": "1–8 Unicode-Zeichen (Emoji), Standard 🌱",
            "example": "🥬"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"]
          },
          "sun": {
            "type": "string",
            "enum": ["full", "partial", "shade"]
          },
          "water": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "season": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["spring", "summer", "autumn", "winter"]
            }
          },
          "spacing": {
            "type": "string",
            "maxLength": 30,
            "example": "25cm"
          },
          "germination": {
            "type": "string",
            "maxLength": 40,
            "example": "5-10 Tage"
          },
          "harvest": {
            "type": "string",
            "maxLength": 60,
            "example": "50-70 Tage"
          },
          "companions": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "avoid": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "tips": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "ExportBundle": {
        "type": "object",
        "description": "Gesamter Datenbestand als ein JSON-Dokument (Format-Version 1).",
        "required": [
          "formatVersion",
          "app",
          "exportedAt",
          "tasks",
          "archivedTasks",
          "plants"
        ],
        "properties": {
          "formatVersion": {
            "type": "integer",
            "enum": [1]
          },
          "app": {
            "type": "string",
            "enum": ["gartenplaner"]
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "archivedTasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "plants": {
            "type": "array",
            "nullable": true,
            "description": "Nur gesetzt, wenn die Instanz eine eigene `plants.json` hat, sonst `null` (Standardbibliothek).",
            "items": {
              "$ref": "#/components/schemas/Plant"
            }
          }
        }
      },
      "ImportBundle": {
        "type": "object",
        "description": "Ein Export-Bündel. `formatVersion`, `tasks` und `archivedTasks` sind Pflicht; `exportedAt` und `app` werden ignoriert. Jede Aufgabe wird wie bei `POST /api/tasks` validiert, zusätzlich müssen `id` (UUID v4) und `createdAt` stimmen; unbekannte Felder werden verworfen.",
        "required": ["formatVersion", "tasks", "archivedTasks"],
        "properties": {
          "formatVersion": {
            "type": "integer",
            "enum": [1]
          },
          "tasks": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          },
          "archivedTasks": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object"
            }
          },
          "plants": {
            "type": "array",
            "nullable": true,
            "maxItems": 1000,
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ImportResult": {
        "type": "object",
        "required": ["mode", "imported", "skipped", "backup"],
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["create", "merge", "replace"]
          },
          "imported": {
            "type": "object",
            "required": ["tasks", "archivedTasks", "plants"],
            "properties": {
              "tasks": {
                "type": "integer"
              },
              "archivedTasks": {
                "type": "integer"
              },
              "plants": {
                "type": "integer"
              }
            }
          },
          "skipped": {
            "type": "object",
            "description": "Nur bei `mode=merge`: vorhandene IDs, die nicht überschrieben wurden.",
            "required": ["tasks", "archivedTasks", "plants"],
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "archivedTasks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plants": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "backup": {
            "type": "string",
            "nullable": true,
            "description": "Nur bei `mode=replace`: Verzeichnis der automatischen Sicherung relativ zum Datenverzeichnis, z. B. `backups/import-2026-11-22T10-00-00-000Z-ab12cd`."
          }
        }
      },
      "PlantFields": {
        "type": "object",
        "description": "Beschreibbare Felder einer Pflanze. Text wird getrimmt und von Steuerzeichen befreit; `<` und `>` sind nicht erlaubt. Unbekannte Felder werden ignoriert.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "example": "Kohlrabi"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Gemüse"
          },
          "icon": {
            "type": "string",
            "description": "1–8 Unicode-Zeichen (Emoji), Standard 🌱",
            "example": "🥬"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"]
          },
          "sun": {
            "type": "string",
            "enum": ["full", "partial", "shade"]
          },
          "water": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "season": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["spring", "summer", "autumn", "winter"]
            }
          },
          "spacing": {
            "type": "string",
            "maxLength": 30,
            "example": "25cm"
          },
          "germination": {
            "type": "string",
            "maxLength": 40,
            "example": "5-10 Tage"
          },
          "harvest": {
            "type": "string",
            "maxLength": 60,
            "example": "50-70 Tage"
          },
          "companions": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "avoid": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "tips": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "PlantInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlantFields"
          },
          {
            "type": "object",
            "required": ["name", "category"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Optional; ohne Angabe leitet der Server den Slug aus `name` ab (Umlaute werden transkribiert)",
                "example": "kohlrabi"
              }
            }
          }
        ]
      },
      "PlantUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlantFields"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Optional; muss der ID im Pfad entsprechen"
              }
            }
          }
        ]
      },
      "PlantId": {
        "type": "string",
        "nullable": true,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 60,
        "example": "tomato",
        "description": "Optionale Pflanzenreferenz (Slug einer Pflanze der Bibliothek, `GET /api/plants`). `null` oder fehlend heißt „ohne Pflanze“; per `PUT` entfernt `null` die Referenz. Beim Anlegen und Ändern muss die Pflanze existieren (sonst 400). Wird die Pflanze später gelöscht, bleibt die Aufgabe gültig und behält die Kennung („verwaist“); ältere Aufgaben ohne Feld brauchen keine Migration. Als Filter ist die Kennung unkritisch in der URL."
      },
      "DueDate": {
        "type": "string",
        "format": "date",
        "nullable": true,
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "example": "2026-03-15",
        "description": "Fälligkeitsdatum als reines Kalenderdatum `YYYY-MM-DD` ohne Uhrzeit und Zeitzone (2000-01-01 bis 2100-12-31, echtes Datum). `null` oder fehlend heißt „ohne Termin“; per `PUT` entfernt `null` das Datum."
      }
    }
  }
}
