{
  "openapi": "3.0.3",
  "info": {
    "title": "Gartenplaner API",
    "version": "1.0.0",
    "description": "REST-API des Gartenplaners (Aufgaben, Archiv, Pflanzenbibliothek). Ist auf dem Server `API_KEY` gesetzt, braucht jeder Aufruf unter `/api` (außer `/api/auth/status`) den Header `X-API-Key`. Pro IP gelten 100 Anfragen je 15 Minuten (`429`). Der Server ist für genau eine Instanz ausgelegt."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Docker Compose"
    },
    {
      "url": "http://localhost:3000",
      "description": "npm start"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Tasks"
    },
    {
      "name": "Archive"
    },
    {
      "name": "Plants"
    }
  ],
  "paths": {
    "/api/auth/status": {
      "get": {
        "tags": ["Auth"],
        "summary": "Ist ein API-Key erforderlich?",
        "description": "Immer ohne Schlüssel erreichbar. Die Weboberfläche nutzt es, um den Key-Dialog zu entscheiden.",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth-Zustand",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["authRequired"],
                  "properties": {
                    "authRequired": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Aufgaben auflisten",
        "description": "Ohne `page`/`limit` kommt ein reines Array (abwärtskompatibel), mit mindestens einem der beiden ein Seitenobjekt. Ein unbekannter `status` wird ignoriert. `employee` und `location` werden mit 400 abgelehnt (Query-Strings landen in Logs); dafür gibt es `POST /api/tasks/search`.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Werte außerhalb 1–200 fallen auf 50 zurück.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array oder Seitenobjekt",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/TaskPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Aufgabe erstellen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Angelegte Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/search": {
      "post": {
        "tags": ["Tasks"],
        "summary": "Aufgaben filtern (Body)",
        "description": "Alle Felder optional und per UND verknüpft; Vergleich exakt nach Mitarbeiter/Standort. Pagination wie bei `GET /api/tasks`.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskSearch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array oder Seitenobjekt",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/TaskPage"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": ["Tasks"],
        "summary": "Aufgabe abrufen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Aufgabe ändern (partiell)",
        "description": "Nur gesendete Felder ändern sich. Statuswechsel und Änderungen erzeugen Historieneinträge; `completed` setzt `completedAt`.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisierte Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Aufgabe löschen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Gelöscht"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}/archive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "tags": ["Archive"],
        "summary": "Aufgabe archivieren",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archivierte Aufgabe (mit `archivedAt`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}/unarchive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "tags": ["Archive"],
        "summary": "Aufgabe aus dem Archiv wiederherstellen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wiederhergestellte Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/archived-tasks": {
      "get": {
        "tags": ["Archive"],
        "summary": "Archivierte Aufgaben auflisten",
        "description": "Immer ein Array, keine Pagination.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archivierte Aufgaben",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/archived-tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "tags": ["Archive"],
        "summary": "Archivierte Aufgabe endgültig löschen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Gelöscht"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plants": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanzenbibliothek auflisten",
        "description": "Immer ein Array. `category` vergleicht exakt, `search` ist eine Teilstring-Suche (ohne Groß-/Kleinschreibung) über Name, Kategorie und Tipps.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Gemüse"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pflanzen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plant"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plants/{id}": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanze abrufen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pflanzen-ID (Slug, z. B. `tomato`)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plant"
                }
              }
            }
          },
          "404": {
            "description": "Unbekannte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plant-categories": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanzenkategorien auflisten",
        "description": "Eindeutige Kategorien, alphabetisch sortiert.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kategorien",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Pflicht, wenn der Server mit `API_KEY` läuft (in Produktion der Standard)."
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Ungültige Anfrage",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationErrors": {
        "description": "Validierung fehlgeschlagen (deutsche Meldungen)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        }
      },
      "InvalidId": {
        "description": "`id` ist keine UUID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "`X-API-Key` fehlt oder ist falsch",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Aufgabe nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Body größer als 100 kB",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Mehr als 100 Anfragen in 15 Minuten. Antwort ist Text (`text/html`), Header `Retry-After` und `RateLimit-*` sind gesetzt.",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Errors": {
        "type": "object",
        "required": ["errors"],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": ["pending", "in-progress", "completed"]
      },
      "Priority": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "Recurrence": {
        "type": "string",
        "enum": ["none", "daily", "weekly", "monthly"],
        "description": "Wiederholung wird nur gespeichert und angezeigt; der Server erzeugt keine Folgeaufgaben."
      },
      "SubtaskInput": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "completed": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "Subtask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "edited",
              "completed",
              "reopened",
              "archived",
              "unarchived"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TaskFields": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "employee": {
            "type": "string",
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence": {
            "$ref": "#/components/schemas/Recurrence"
          },
          "subtasks": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/SubtaskInput"
            }
          }
        }
      },
      "TaskInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TaskFields"
          },
          {
            "type": "object",
            "required": ["title", "location"]
          }
        ]
      },
      "TaskUpdate": {
        "$ref": "#/components/schemas/TaskFields"
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "location",
          "status",
          "priority",
          "recurrence",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "employee": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence": {
            "$ref": "#/components/schemas/Recurrence"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sortOrder": {
            "type": "number"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subtask"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            }
          }
        }
      },
      "TaskPage": {
        "type": "object",
        "required": ["data", "total", "page", "limit", "pages"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "TaskSearch": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "employee": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "Plant": {
        "type": "object",
        "required": ["id", "name", "category"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "sun": {
            "type": "string"
          },
          "water": {
            "type": "string"
          },
