{
  "openapi": "3.0.3",
  "info": {
    "title": "Gartenplaner API",
    "version": "1.0.0",
    "description": "REST-API des Gartenplaners (Aufgaben, Archiv, Pflanzenbibliothek, Export/Import). Ist auf dem Server `API_KEY` gesetzt, braucht jeder Aufruf unter `/api` (außer `/api/auth/status`) den Header `X-API-Key`. Pro IP gelten 100 Anfragen je 15 Minuten (`429`). Der Server ist für genau eine Instanz ausgelegt."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Docker Compose"
    },
    {
      "url": "http://localhost:3000",
      "description": "npm start"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Tasks"
    },
    {
      "name": "Archive"
    },
    {
      "name": "Plants"
    },
    {
      "name": "Backup"
    }
  ],
  "paths": {
    "/api/auth/status": {
      "get": {
        "tags": ["Auth"],
        "summary": "Ist ein API-Key erforderlich?",
        "description": "Immer ohne Schlüssel erreichbar. Die Weboberfläche nutzt es, um den Key-Dialog zu entscheiden.",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth-Zustand",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["authRequired"],
                  "properties": {
                    "authRequired": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Aufgaben auflisten",
        "description": "Ohne `page`/`limit` kommt ein reines Array (abwärtskompatibel), mit mindestens einem der beiden ein Seitenobjekt. Ein unbekannter `status` wird ignoriert. `employee` und `location` werden mit 400 abgelehnt (Query-Strings landen in Logs); dafür gibt es `POST /api/tasks/search`. `dueFrom`/`dueTo` (inklusive) filtern nach Fälligkeit, `sort=dueDate` sortiert aufsteigend (ohne Termin zuletzt, vor der Pagination); `plantId` filtert nach der Pflanzenreferenz; ungültige Werte ergeben 400.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "name": "dueFrom",
            "in": "query",
            "description": "Nur Aufgaben mit Fälligkeit ab diesem Tag (inklusive, `YYYY-MM-DD`). Aufgaben ohne Termin fallen heraus.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "dueTo",
            "in": "query",
            "description": "Nur Aufgaben mit Fälligkeit bis zu diesem Tag (inklusive, `YYYY-MM-DD`).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "plantId",
            "in": "query",
            "description": "Nur Aufgaben, die auf diese Pflanze verweisen (Slug, z. B. `tomato`). Ein Slug ohne Pflanze in der Bibliothek liefert die Aufgaben mit verwaister Referenz, sonst nichts; ein ungültiges Format ergibt 400.",
            "schema": {
              "$ref": "#/components/schemas/PlantId"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sortierung nach Fälligkeit, aufsteigend; Aufgaben ohne Termin stehen zuletzt.",
            "schema": {
              "type": "string",
              "enum": ["dueDate"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Werte außerhalb 1–200 fallen auf 50 zurück.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array oder Seitenobjekt",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/TaskPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Aufgabe erstellen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Angelegte Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/search": {
      "post": {
        "tags": ["Tasks"],
        "summary": "Aufgaben filtern (Body)",
        "description": "Alle Felder optional und per UND verknüpft; Vergleich exakt nach Mitarbeiter/Standort. Pagination wie bei `GET /api/tasks`. Zusätzlich `dueFrom`, `dueTo`, `sort` und `plantId` wie bei `GET /api/tasks`; ungültige Werte ergeben 400.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskSearch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array oder Seitenobjekt",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Task"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/TaskPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": ["Tasks"],
        "summary": "Aufgabe abrufen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Aufgabe ändern (partiell)",
        "description": "Nur gesendete Felder ändern sich. Statuswechsel und Änderungen erzeugen Historieneinträge; `completed` setzt `completedAt`. Wechselt eine Aufgabe mit `recurrence` ungleich `none` auf `completed`, legt der Server im selben Schreibvorgang die Folgeaufgabe an (alles oder nichts) und liefert sie als `followUp` mit. Nur der Übergang zu `completed` zählt: ein weiteres PUT auf eine abgeschlossene Aufgabe erzeugt keine zweite Folgeaufgabe. Eine geänderte `plantId` muss in der Pflanzenbibliothek existieren (sonst 400); eine unverändert mitgesendete, inzwischen verwaiste `plantId` und `null` zum Entfernen sind immer erlaubt.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisierte Aufgabe; bei einem Abschluss mit Wiederholung zusätzlich `followUp`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskUpdateResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Aufgabe löschen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Gelöscht"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}/archive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "tags": ["Archive"],
        "summary": "Aufgabe archivieren",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archivierte Aufgabe (mit `archivedAt`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/tasks/{id}/unarchive": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "tags": ["Archive"],
        "summary": "Aufgabe aus dem Archiv wiederherstellen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wiederhergestellte Aufgabe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/archived-tasks": {
      "get": {
        "tags": ["Archive"],
        "summary": "Archivierte Aufgaben auflisten",
        "description": "Immer ein Array, keine Pagination.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Archivierte Aufgaben",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/archived-tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID v4 der Aufgabe",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "tags": ["Archive"],
        "summary": "Archivierte Aufgabe endgültig löschen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Gelöscht"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plants": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanzenbibliothek auflisten",
        "description": "Immer ein Array. `category` vergleicht exakt, `search` ist eine Teilstring-Suche (ohne Groß-/Kleinschreibung) über Name, Kategorie und Tipps. Ohne `plants.json` im Datenverzeichnis liefert der Server die 20 Standardpflanzen.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Gemüse"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pflanzen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Plant"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": ["Plants"],
        "summary": "Pflanze anlegen",
        "description": "Beim ersten Schreibzugriff werden die Standardpflanzen nach `DATA_DIR/plants.json` übernommen; die Standarddaten im Repository bleiben unverändert. Ist `plants.json` beschädigt, antwortet der Server mit `500` und überschreibt die Datei nicht.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlantInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Angelegte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plant"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Es gibt bereits eine Pflanze mit dieser ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plants/{id}": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanze abrufen",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pflanzen-ID (Slug, z. B. `tomato`)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plant"
                }
              }
            }
          },
          "404": {
            "description": "Unbekannte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "put": {
        "tags": ["Plants"],
        "summary": "Pflanze ändern (partiell)",
        "description": "Nur gesendete Felder ändern sich. Die ID lässt sich nicht ändern. Auch Standardpflanzen sind änderbar (siehe `POST /api/plants`).",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pflanzen-ID (Slug, z. B. `tomato`)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlantUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktualisierte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plant"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unbekannte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "tags": ["Plants"],
        "summary": "Pflanze löschen",
        "description": "Auch Standardpflanzen sind löschbar. Die Bibliothek darf leer werden. Zurücksetzen auf die Standardpflanzen: `plants.json` im Datenverzeichnis löschen.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Pflanzen-ID (Slug, z. B. `tomato`)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Gelöscht"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Unbekannte Pflanze",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/plant-categories": {
      "get": {
        "tags": ["Plants"],
        "summary": "Pflanzenkategorien auflisten",
        "description": "Eindeutige Kategorien, alphabetisch sortiert.",
